{
  "compilerOptions": {
    "target": "es2017",
    "lib": [
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "strict": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "types.d.ts",
    "tsdown.config.mts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages"
  ]
}