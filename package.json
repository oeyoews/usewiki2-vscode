{
  "name": "usewiki2",
  "displayName": "usewiki2",
  "version": "3.0.0",
  "private": true,
  "description": "",
  "categories": [
    "Education"
  ],
  "keywords": [
    "TiddlyWiki",
    "Usewiki2"
  ],
  "homepage": "https://github.com/oeyoews/usewiki2-vscode#readme",
  "license": "MIT",
  "author": {
    "name": "oeyoews"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oeyoews/usewiki2-vscode#readme"
  },
  "funding": "https://github.com/sponsors/oeyoews",
  "publisher": "oeyoews",
  "files": [
    "dist",
    "res",
    "LICENSE",
    "l10n",
    "package.nls*.json"
  ],
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "open:devhost": "cursor --new-window --extensionDevelopmentPath=.",
    "update": "vscode-ext-gen --output src/generated/meta.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "vscode:prepublish": "tsdown",
    "publish": "vsce publish --no-dependencies",
    "package": "pnpm run build && vsce package --no-dependencies",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp && nr publish"
  },
  "dependencies": {
    "@vscode/l10n": "^0.0.18"
  },
  "devDependencies": {
    "@antfu/ni": "^30.6.0",
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.145.0",
    "@vscode/vsce": "^4.1.0",
    "bumpp": "^12.3.0",
    "esno": "^4.8.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "rimraf": "^6.1.4",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "vscode-ext-gen": "^1.6.0"
  },
  "l10n": "./l10n",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "%usewiki2.config.title%",
      "properties": {
        "usewiki2.defaultTag": {
          "type": "string",
          "default": "Journal",
          "title": "%usewiki2.defaultTag.title%",
          "description": "%usewiki2.defaultTag.description%"
        },
        "usewiki2.defaultUsername": {
          "type": "string",
          "default": "",
          "title": "%usewiki2.defaultUsername.title%",
          "description": "%usewiki2.defaultUsername.description%"
        },
        "usewiki2.ip": {
          "order": 0,
          "type": "string",
          "default": "127.0.0.1",
          "title": "%usewiki2.ip.title%",
          "description": "%usewiki2.ip.description%"
        },
        "usewiki2.port": {
          "order": 1,
          "type": "number",
          "default": 8080,
          "title": "%usewiki2.port.title%",
          "description": "%usewiki2.port.description%"
        },
        "usewiki2.enableHttps": {
          "order": 2,
          "type": "boolean",
          "default": false,
          "title": "%usewiki2.enableHttps.title%",
          "description": "%usewiki2.enableHttps.description%"
        },
        "usewiki2.type": {
          "order": 3,
          "type": "string",
          "default": "text/vnd.tiddlywiki",
          "enum": [
            "text/markdown",
            "text/vnd.tiddlywiki"
          ],
          "enumItemLabels": [
            "%usewiki2.type.enum.markdown.label%",
            "%usewiki2.type.enum.wiki.label%"
          ],
          "markdownEnumDescriptions": [
            "%usewiki2.type.enum.markdown%",
            "%usewiki2.type.enum.wiki%"
          ],
          "title": "%usewiki2.type.title%",
          "description": "%usewiki2.type.description%"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "usewiki2.opensettings",
          "group": "navigation",
          "when": "view == usewiki2.sidebar"
        }
      ],
      "editor/title": [
        {
          "command": "usewiki2.sendToWiki",
          "group": "navigation",
          "when": "resourceScheme == usewiki-compose"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "usewiki2Container",
          "title": "usewiki",
          "icon": "res/tw.svg"
        }
      ]
    },
    "views": {
      "usewiki2Container": [
        {
          "id": "usewiki2.sidebar",
          "name": "TiddlyWiki",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "usewiki2.wikiinfo",
        "title": "%usewiki2.tiddlywiki.title%",
        "icon": "$(info)"
      },
      {
        "command": "usewiki2.openwiki",
        "title": "%usewiki2.openwiki.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "usewiki2.opensettings",
        "title": "%usewiki2.opensettings.title%",
        "icon": "$(gear)"
      },
      {
        "command": "usewiki2.openComposer",
        "title": "%usewiki2.openComposer.title%",
        "icon": "$(edit)"
      },
      {
        "command": "usewiki2.sendToWiki",
        "title": "%usewiki2.sendToWiki.title%",
        "icon": "$(save)"
      },
      {
        "command": "usewiki2.showHint",
        "title": "%usewiki2.showHint.title%",
        "icon": "$(info)"
      }
    ],
    "keybindings": [
      {
        "command": "usewiki2.sendToWiki",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && resourceScheme == usewiki-compose"
      }
    ]
  },
  "activationEvents": [
    "onCommand:usewiki2.openComposer",
    "onCommand:usewiki2.sendToWiki",
    "onFileSystem:usewiki-compose",
    "onStartupFinished",
    "onView:usewiki2.sidebar"
  ],
  "icon": "res/tiddlywiki01.png",
  "engines": {
    "vscode": "^1.145.0"
  },
  "packageManager": "pnpm@12.18.0",
  "pricing": "Free"
}
