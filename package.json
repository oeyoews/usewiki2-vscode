{
  "name": "usewiki2",
  "displayName": "usewiki2",
  "version": "2.8.4",
  "private": true,
  "description": "",
  "categories": [
    "Education"
  ],
  "keywords": [
    "TiddlyWiki",
    "Usewiki2"
  ],
  "homepage": "https://github.com/oeyoews/usewiki2-vscode#readme",
  "license": "MIT",
  "author": {
    "name": "oeyoews"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oeyoews/usewiki2-vscode#readme"
  },
  "funding": "https://github.com/sponsors/oeyoews",
  "publisher": "oeyoews",
  "files": [
    "dist",
    "res",
    "react-dist",
    "LICENSE",
    "l10n",
    "package.nls*.json"
  ],
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsdown",
    "dev": "nr build --watch",
    "update": "vscode-ext-gen --output src/generated/meta.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "vscode:prepublish": "nr build",
    "publish": "vsce publish --no-dependencies",
    "build:react": "cd packages/react && pnpm build && cd ../..",
    "package": "pnpm build:react && vsce package --no-dependencies",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && pnpm -C packages/react exec tsc -b",
    "release": "bumpp && nr publish"
  },
  "dependencies": {
    "@vscode/l10n": "^0.0.18"
  },
  "devDependencies": {
    "@antfu/ni": "^30.6.0",
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.145.0",
    "@vscode/vsce": "^4.1.0",
    "bumpp": "^12.3.0",
    "esno": "^4.8.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "rimraf": "^6.1.4",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vscode-ext-gen": "^1.6.0"
  },
  "l10n": "./l10n",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "UseWiki2",
      "properties": {
        "usewiki2.enableMeteors": {
          "type": "boolean",
          "default": false,
          "description": "%usewiki2.enableMeteors%"
        },
        "usewiki2.enableSendSound": {
          "type": "boolean",
          "default": false,
          "description": "%usewiki2.enableSendSound.title%"
        },
        "usewiki2.defaultTag": {
          "type": "string",
          "default": "Journal",
          "description": "%usewiki2.defaultTag.title%"
        },
        "usewiki2.defaultUsername": {
          "type": "string",
          "default": "",
          "description": "%usewiki2.defaultUsername%"
        },
        "usewiki2.ip": {
          "order": 0,
          "type": "string",
          "default": "127.0.0.1",
          "description": "%usewiki2.ip%"
        },
        "usewiki2.port": {
          "order": 1,
          "type": "number",
          "default": 8080,
          "description": "%usewiki2.port%"
        },
        "usewiki2.enableHttps": {
          "order": 2,
          "type": "boolean",
          "default": false,
          "description": "%usewiki2.enableHttps%"
        },
        "usewiki2.lang": {
          "type": "string",
          "default": "en",
          "enum": [
            "en",
            "zhCN"
          ],
          "enumItemLabels": [
            "English",
            "Simplified Chinese"
          ],
          "description": "%usewiki2.lang%"
        },
        "usewiki2.type": {
          "order": 3,
          "type": "string",
          "default": "text/vnd.tiddlywiki",
          "enum": [
            "text/markdown",
            "text/vnd.tiddlywiki"
          ],
          "enumItemLabels": [
            "Markdown",
            "WikiText"
          ],
          "markdownEnumDescriptions": [
            "use Markdown",
            "use WikiText"
          ],
          "description": "%usewiki2.type%"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "usewiki2.openwiki",
          "group": "navigation",
          "when": "view == usewiki2"
        },
        {
          "command": "usewiki2.opensettings",
          "group": "navigation",
          "when": "view == usewiki2"
        },
        {
          "command": "usewiki2.wikiinfo",
          "group": "navigation",
          "when": "view == usewiki2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "usewiki2Container",
          "title": "usewiki",
          "icon": "res/tw.svg"
        }
      ]
    },
    "views": {
      "usewiki2Container": [
        {
          "id": "usewiki2",
          "type": "webview",
          "name": "TiddlyWiki"
        }
      ]
    },
    "commands": [
      {
        "command": "usewiki2.wikiinfo",
        "title": "%usewiki2.tiddlywiki.title%",
        "icon": "$(info)"
      },
      {
        "command": "usewiki2.openwiki",
        "title": "%usewiki2.openwiki.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "usewiki2.opensettings",
        "title": "%usewiki2.opensettings.title%",
        "icon": "$(gear)"
      }
    ]
  },
  "icon": "res/tiddlywiki01.png",
  "engines": {
    "vscode": "^1.105.0"
  },
  "packageManager": "pnpm@12.18.0",
  "pricing": "Free"
}
