{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Extension (Cursor, recommended)",
      "type": "extensionHost",
      "request": "launch",
      "noDebug": true,
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "build extension",
      "debugWebWorkerExtensions": false
    },
    {
      "name": "Extension (isolated)",
      "type": "extensionHost",
      "request": "launch",
      "noDebug": true,
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "build extension",
      "debugWebWorkerExtensions": false
    },
    {
      "name": "Extension (debug breakpoints)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "build extension",
      "stopOnEntry": false,
      "debugWebWorkerExtensions": false
    },
    {
      "name": "Extension (watch + debug breakpoints)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "watch extension",
      "stopOnEntry": false,
      "debugWebWorkerExtensions": false
    }
  ]
}